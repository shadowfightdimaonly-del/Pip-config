workflows:
  android-workflow:
    name: Pip Config Android Build
    max_build_duration: 30
    instance_type: mac_mini_m1
    environment:
      groups:
        - android-signing
      flutter: stable
      xcode: stable
      cocoapods: default
    triggering:
      events:
        - push
      branch_patterns:
        - pattern: '*'
          include: true
    scripts:
      - name: Set up local.properties
        script: |
          echo "flutter.sdk=$FLUTTER_ROOT" > android/local.properties
      - name: Get Flutter dependencies
        script: |
          flutter pub get
      - name: Build Android APK
        script: |
          flutter build apk --release --no-sound-null-safety
    artifacts:
      - build/app/outputs/flutter-apk/*-release.apk
    publishing:
      email:
        recipients:
          - your-email@gmail.com # Можешь вписать свой email, чтобы билд прилетал на почту
        notify:
          success: true
          failure: true
